#!/bin/sh

# Offline fixture only: never contact a real password store.
case "${0##*/}" in
    security)
        [ "$#" -eq 6 ] && [ "$1" = find-generic-password ] &&
            [ "$2" = -a ] && [ "$4" = -s ] &&
            [ "$5" = example-service ] && [ "$6" = -w ] || exit 2
        ;;
    pass)
        [ "$#" -eq 2 ] && [ "$1" = show ] && [ "$2" = api/example ] || exit 2
        ;;
    *) exit 2 ;;
esac

case "${DOTFILES_TEST_SECRET_MODE:-ok}" in
    fail)
        printf '%s\n' 'fixture value must not be used on failure'
        exit 1
        ;;
    empty) exit 0 ;;
esac

printf '%s\n' 'fixture value with spaces'
if [ "${0##*/}" = pass ]; then
    printf '%s\n' 'Notes: fixture metadata must not enter the credential'
fi
