# Optional: copy to ~/.config/fish/secrets.local.fish and chmod 600 that file.
# Keep only environment-variable names and password-store references here.
# ANTHROPIC_AUTH_TOKEN is loaded from Keychain by default when available.

# macOS Keychain service names (the account is $USER):
# dotfiles_load_secret GEMINI_API_KEY keychain gemini-api-key

# pass entry names (the credential is the first line):
# dotfiles_load_secret ANTHROPIC_AUTH_TOKEN pass api/anthropic
# dotfiles_load_secret GEMINI_API_KEY pass api/gemini
